PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://aagdoom:aagdoom@localhost:5432/aagdoom?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_access_secret_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_secret_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=admin@aagdoom.com
ADMIN_PASSWORD=Admin@123
SEED_IMAGE_PROVIDER=https://picsum.photos/seed

# Real payment gateway credentials (leave blank to enable the sandbox gateway)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_SANDBOX=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Notifications (leave blank => logs to console)
SENDGRID_API_KEY=
SMS_PROVIDER=
UPLOAD_DIR=./uploads